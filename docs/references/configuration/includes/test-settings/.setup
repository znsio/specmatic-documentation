if [[ "$DOC_EXAMPLE_NAME" != "start-demo.sh" ]]; then
node demo-server.cjs > demo.log 2>&1 &
demo_pid=$!
cleanup() {
  result=$?
  kill "$demo_pid" 2>/dev/null || true
  wait "$demo_pid" 2>/dev/null || true
  if [[ "$result" == 0 ]]; then
    node .check-report.cjs || exit 1
  fi
  exit "$result"
}
trap cleanup EXIT
ready=false
for attempt in {1..100}; do
  if grep -q 'Demo Books API is ready' demo.log; then ready=true; break; fi
  kill -0 "$demo_pid" 2>/dev/null || { cat demo.log; exit 1; }
  sleep 0.1
done
[[ "$ready" == true ]] || { cat demo.log; exit 1; }
fi
