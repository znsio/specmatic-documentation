if [[ "$DOC_EXAMPLE_NAME" == test* ]]; then
  grpc_demo_port=9100
  if [[ "$DOC_EXAMPLE_NAME" == test-override.sh ]]; then grpc_demo_port=9102; fi
  grpc_demo_delay=0
  if [[ "$DOC_EXAMPLE_NAME" == test-timeout*.sh ]]; then grpc_demo_delay=1200; fi
  DEMO_GRPC_DELAY_MS="$grpc_demo_delay" DEMO_GRPC_PORT="$grpc_demo_port" node target.cjs > target.log 2>&1 &
  grpc_demo_pid=$!
  cleanup() {
    result=$?
    kill "$grpc_demo_pid" 2>/dev/null || true
    wait "$grpc_demo_pid" 2>/dev/null || true
    node check-routing.cjs "$grpc_demo_port" "$DOC_EXAMPLE_NAME" || exit 2
    exit "$result"
  }
  trap cleanup EXIT
  ready=false
  for attempt in {1..100}; do
    if grep -q 'gRPC demo ready' target.log; then ready=true; break; fi
    kill -0 "$grpc_demo_pid" 2>/dev/null || { cat target.log; exit 1; }
    sleep 0.1
  done
  [[ "$ready" == true ]] || { cat target.log; exit 1; }
fi
if [[ "$DOC_EXAMPLE_NAME" == request*.sh ]]; then
  grpc_mock_config=mock.yaml
  if [[ "$DOC_EXAMPLE_NAME" == request-custom.sh ]]; then grpc_mock_config=mock-custom.yaml; fi
  docker run --rm --network host -v ./:/usr/src/app -v "$HOME/.specmatic:/root/.specmatic" --env CONFIG_FILE_PATH="$grpc_mock_config" specmatic/enterprise mock > mock.log 2>&1 &
  grpc_mock_pid=$!
  trap 'kill "$grpc_mock_pid" 2>/dev/null || true; wait "$grpc_mock_pid" 2>/dev/null || true' EXIT
  ready=false
  for attempt in {1..600}; do
    if grep -q 'gRPC Stub server is running' mock.log; then ready=true; break; fi
    kill -0 "$grpc_mock_pid" 2>/dev/null || { cat mock.log; exit 1; }
    sleep 0.1
  done
  [[ "$ready" == true ]] || { cat mock.log; exit 1; }
fi
